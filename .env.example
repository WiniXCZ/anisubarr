# ── App ─────────────────────────────────────────────────────────────
APP_NAME=Anisubarr
DEBUG=false

# ── JWT (generate a long random secret for production) ───────────────
JWT_SECRET=change-me-to-something-random
JWT_EXPIRE_MINUTES=10080   # 7 days

# ── Sonarr ───────────────────────────────────────────────────────────
SONARR_HOST=192.168.1.10:8989
SONARR_API_KEY=your_sonarr_api_key_here

# ── Ollama ───────────────────────────────────────────────────────────
OLLAMA_HOST=192.168.1.10:11434
OLLAMA_MODEL_TRANSLATE=qwen2.5:14b
OLLAMA_MODEL_AGENT=qwen2.5:1.5b

# ── Media access mode ──────────────────────────────────────────────────
# "local" = plain root directory (recommended for Docker — mount your media
#           as a volume and point PATH_LOCAL_PREFIX at the in-container path)
# "smb"   = access an SMB/CIFS network share directly (mainly for running
#           the backend outside Docker, e.g. during Windows development)
MEDIA_ACCESS_MODE=local

# ── SMB / Media (only used when MEDIA_ACCESS_MODE=smb) ─────────────────
SMB_HOST=
SMB_USERNAME=
SMB_PASSWORD=

# ── Path mapping (Sonarr path → locally accessible path) ─────────────
# Sonarr always returns its own internal paths, e.g. /data/media/...
# You need to tell Anisubarr how to reach those files from its own process.
#
#   Windows dev (SMB, MEDIA_ACCESS_MODE=smb):
#     PATH_SONARR_PREFIX=/data
#     PATH_LOCAL_PREFIX=\\<nas-ip-or-hostname>\data
#     (set SMB_USERNAME/PASSWORD if the share requires auth)
#
#   Docker / Unraid (volume mount, MEDIA_ACCESS_MODE=local):
#     PATH_SONARR_PREFIX=/data
#     PATH_LOCAL_PREFIX=/media
#     (mount the share as:  - /mnt/user:/media:rw  in docker-compose)
#
PATH_SONARR_PREFIX=/data
PATH_LOCAL_PREFIX=/media

# ── FFmpeg ───────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Subtitle scrapers ────────────────────────────────────────────────
HIYORI_USERNAME=
HIYORI_PASSWORD=
HNS_USERNAME=
HNS_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./anisubarr.db

# ── Webhooks ─────────────────────────────────────────────────────────
# REQUIRED for production: without this, /api/webhooks/sonarr accepts
# unauthenticated requests from anyone who can reach the container.
# Generate one with: openssl rand -hex 24
# Set the same value as the "X-Webhook-Token" header (or ?token=) in
# Sonarr's webhook connection settings.
WEBHOOK_SECRET=change-me-to-a-random-string

# ── alass (subtitle timing sync) ──────────────────────────────────────
# Built into the Docker image at /usr/local/bin/alass — no path change needed
# unless running outside Docker. ffsubsync (pip-installed) is used automatically
# as a fallback engine when alass fails.
ALASS_PATH=alass

# ── Public visitor site ─────────────────────────────────────────────────
# A separate, unauthenticated read-only site (připravované/zažádáno/nahlášené
# problémy/zveřejněné + newsletter signup) served on its own port — see
# backend/app/public_main.py and public_site/. PUBLIC_PORT is the port
# *inside* the container; PUBLIC_SITE_HOST_PORT (docker-compose.yml) is what
# you map it to on the host. Set PUBLIC_PORT=0 to disable the site entirely.
PUBLIC_PORT=8090
PUBLIC_SITE_HOST_PORT=8090
# Public URL people actually use to reach the site above — used in newsletter
# emails for the unsubscribe link.
PUBLIC_SITE_URL=

# ── Newsletter (SMTP) — optional, needed only for the "Odebírat novinky" ──
# feature on the public site. Configurable in Nastavení → Veřejný web too;
# .env values here are just the fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
